# Time format test script
# Safe to delete after use.
# weekly-end-reset.sk only fires when the time prints like "12:00"
# and the weekday prints as "Sunday" (English) - use /testtime to check.

command /testtime:
    permission: op
    trigger:
        set {_time} to now formatted as "HH:mm"
        set {_day} to now formatted as "EEEE"
        send "&eTime format: &f%{_time}%"
        send "&eWeekday format: &f%{_day}%"
